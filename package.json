{
  "name": "airo-share",
  "version": "1.3.9",
  "type": "module",
  "description": "High Performance PC Media Server & Local File Engine",
  "author": "AiroShare Team",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server.js",
    "start": "node server.js",
    "dlna": "node simple_dlna.js",
    "electron:dev": "electron .",
    "dist:portable": "electron-builder --win portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:all": "electron-builder --win"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "ftp-srv": "^4.6.3",
    "lucide-react": "^0.395.0",
    "mime-types": "^2.1.35",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "com.airoshare.app",
    "productName": "AiroShare",
    "npmRebuild": false,
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "icon": "public/AiroShare.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AiroShare"
    },
    "files": [
      "dist/**/*",
      "node_modules/**/*",
      "server.js",
      "ftpServer.js",
      "config/dlna.js",
      "electron-main.cjs",
      "electron-preload.cjs",
      "src/dlna/**/*",
      "src/utils/**/*",
      "public/AiroShare.png",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": []
  }
}
